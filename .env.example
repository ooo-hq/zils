# Server only. Copy to ignored .private/training.env and replace the placeholders.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-service-role-key
# Exact public API base URL, also configured on workers. Loopback HTTP is for development.
ZILS_TRAINING_API_URL=http://127.0.0.1:8910
ZILS_WEB_ORIGIN=http://localhost:3000
# Hosted queue model. Existing jobs retain the model pinned in their manifest.
ZILS_TRAINING_MODEL=jevk5-4b-v0.3

# Optional image admissions stay off until image worker/runtime rollout is verified.
ZILS_IMAGES_ENABLED=0
ZILS_IMAGE_TRAINING_ENABLED=0

# Private file storage. Enable the catalog only after its migration is applied.
# Keep the catalog on during rollback once any Spaces files exist.
ZILS_STORAGE_CATALOG=off
ZILS_STORAGE_WRITE_PROVIDER=supabase
ZILS_SPACES_ENDPOINT=
ZILS_SPACES_REGION=
ZILS_SPACES_BUCKET=
ZILS_SPACES_ACCESS_KEY_ID=
ZILS_SPACES_SECRET_ACCESS_KEY=
# Image runtime needs only --spaces-store-origin https://bucket.region.digitaloceanspaces.com
# GPU training subprocesses must never receive the Spaces access keys.
