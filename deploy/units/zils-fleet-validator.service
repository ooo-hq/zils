[Unit]
Description=Zils fleet validator (chain rounds)
After=network-online.target
Wants=network-online.target
[Service]
User=zilsminer
Group=zilsminer
SupplementaryGroups=zils-compute
WorkingDirectory=/opt/zils
EnvironmentFile=/etc/zils-node/node.env
ExecStart=/opt/zils/.venv-kev/bin/python -m zils.fleet validator --config /etc/zils-node/fleet/validator/config.json --runtime-python /opt/zils/.venv-d3/bin/python --device cuda
Restart=on-failure
RestartSec=15
KillMode=control-group
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/zils-node /var/lock/zils-training /etc/zils-node/fleet
[Install]
WantedBy=multi-user.target
