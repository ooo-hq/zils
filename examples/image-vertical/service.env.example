# Server-only placeholders. Copy to protected, ignored configuration.
ZILS_IMAGES_ENABLED=0
ZILS_IMAGE_TRAINING_ENABLED=0
ZILS_IMAGE_RUNTIME_TOKEN=replace-with-a-private-runtime-token
ZILS_IMAGE_REFERENCE=/srv/zils/image-reference
ZILS_IMAGE_RUNTIME_PYTHON=/srv/zils/image-venv/bin/python
# Minimum is a floor; raise it using maximum-context qualification evidence.
ZILS_IMAGE_MIN_FREE_MIB=12288
# Optional per-process CUDA allocator ceiling; qualify the exact host setting.
# ZILS_IMAGE_GPU_MEMORY_FRACTION=0.55
ZILS_COMPUTE_LOCK=/run/lock/zils-training/cuda.lock
ZILS_NVIDIA_SMI=/usr/bin/nvidia-smi
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
# Existing text services retain their existing profile/routing configuration.
ZILS_TRAINING_MODEL=jevk5-4b-v0.3
ZILS_TRAINING_API_URL=https://training.example.com
ZILS_WEB_ORIGIN=https://app.example.com
