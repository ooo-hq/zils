# Server-only. Copy to ignored .private/api/service.env and replace placeholders.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_SERVICE_ROLE_KEY
# Generate once with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Share only between the trusted gateway/worker and private GPU runtime.
ZILS_RUNTIME_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_ASCII_CHARACTERS
# Manual prepaid billing. Keep off until docs/billing.md test setup is complete.
# Test mode requires an isolated test Supabase project, gateway, worker, and runtime.
ZILS_BILLING_MODE=off
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ZILS_BILLING_RETURN_ORIGIN=
ZILS_BILLING_ALLOW_LIVE=false
